@startuml Diagramme de Composants Frontend - R.Tournée

title Diagramme de Composants Frontend - R.Tournée

left to right direction

skinparam backgroundColor #FFFFFF
skinparam component {
    BackgroundColor #4472C4
    FontColor #FFFFFF
    FontStyle bold
    FontSize 13
    BorderColor #2B579A
    RoundCorner 15
}
skinparam package {
    BackgroundColor #F0F4FA
    BorderColor #4472C4
    FontColor #1B3A5C
    FontStyle bold
    FontSize 14
}

' ========== 1. Point d'entrée ==========
component [App.jsx] as app #2B579A

' ========== 2. Composants UI ==========
package "Composants UI" {
    component [LoginScreen] as login
    component [Sidebar] as sidebar
    component [AiChatbot] as chatbot
    component [Map / Leaflet] as mapcomp
}

' ========== 3. Pages ==========
package "Pages" {
    component [TourneePage] as tournee
    component [DashboardPage] as dashboard
    component [SimulateurPage] as simulateur
    component [ParametragePage] as parametrage
    component [OptimisationPage] as optimisation
    component [AiDashboardPage] as aidashboard
    component [AdminPage] as admin
}

' ========== 4. Hooks ==========
package "Hooks" {
    component [useTmsData] as hookTms #ED7D31
    component [useAlerts] as hookAlerts #ED7D31
    component [useCalculateTarif] as hookTarif #ED7D31
}

' ========== 5. Services & Utils ==========
package "Services & Utils" {
    component [apiBase] as utilApi #70AD47
    component [locationService] as svcLoc #70AD47
    component [tarifApi] as svcTarif #70AD47
    component [geocoding] as utilGeo #70AD47
}

' ========== 6. Backend ==========
interface "API REST\nNestJS :3000" as backendApi

' ========== Relations ==========
app --> login
app --> sidebar
app --> chatbot

app --> tournee
app --> dashboard
app --> simulateur
app --> parametrage
app --> optimisation
app --> aidashboard
app --> admin

tournee --> mapcomp

app --> hookTms
app --> hookAlerts

hookTms --> utilApi
hookAlerts --> utilApi
hookTarif --> svcTarif

svcLoc --> utilGeo
svcTarif --> utilApi

utilApi --> backendApi : HTTP
svcLoc --> backendApi : HTTP

@enduml
