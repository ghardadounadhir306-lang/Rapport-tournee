# Backend (NestJS) database connection (PostgreSQL recommended)
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

# Optional dedicated source DB (TMS) connection for transport_data + chauffeurs.
# If omitted, DB_* host/user/password are reused and DB defaults to TMS_DB.
TMS_DB_HOST=127.0.0.1
TMS_DB_PORT=5432
TMS_DB_USER=postgres
TMS_DB_PASSWORD=postgres
TMS_DB_NAME=TMS_DB

# Optional
DB_LOGGING=false
DB_SYNCHRONIZE=true

# Max import rows loaded for GET /api/tms sidebar (deduped by TMS id). Default 100000.
# Lower this if the process runs out of memory on huge databases.
TMS_LIST_MAX_ROWS=100000

# Server port
PORT=3001

# OSRM Route API (km routier pour Km TH tournée). Défaut = démo publique project-osrm.org
OSRM_ROUTE_BASE=https://router.project-osrm.org/route/v1/driving

# If true, DONNEE_MANQUANTE also requires prestation_id and site_id on tour forms
ANOMALY_STRICT_REQUIRED=false

# Min GPS points linked to a tms form before clearing TRUCK / no-GPS alert. Default 3 in code; use 0 to turn off.
GPS_MIN_POINTS_REAL_ROUTE=3

# Gmail SMTP (use an App Password, not your normal password; strip spaces from SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional; defaults to SMTP_USER
MAIL_FROM=

# Set to true only in dev to enable POST /api/mail/test (sends a test message)
MAIL_TEST_ENABLED=false
