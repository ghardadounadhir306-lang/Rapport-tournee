# Backend (NestJS) PostgreSQL connection
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

TMS_DB_HOST=127.0.0.1
TMS_DB_PORT=5433
TMS_DB_USER=postgres
TMS_DB_PASSWORD=postgres
TMS_DB_NAME=TMS_DB

# Optional
DB_LOGGING=false
DB_SYNCHRONIZE=true

# Server port
PORT=3001

# GPS alerts: min points for “truck must have a trace” (0 = disable that check)
GPS_MIN_POINTS_REAL_ROUTE=0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional; defaults to SMTP_USER
MAIL_FROM=